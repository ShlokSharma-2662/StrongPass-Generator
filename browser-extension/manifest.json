{
    "manifest_version": 3,
    "name": "StrongPass Generator",
    "version": "1.0",
    "description": "Generate secure, strong passwords instantly.",
    "permissions": [
        "clipboardWrite",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Generate Password"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}